<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" prefHeight="500.0" prefWidth="600.0"
      style="-fx-background-color: #f0f4f8;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chris.sd_assignment1.controller.OrderSummaryController">

    <Label text="Order Placed Successfully!" textFill="#2ecc71">
        <font>
            <Font name="System Bold" size="32.0" />
        </font>
    </Label>

    <Label text="Thank you for shopping with us." textFill="#34495e">
        <font>
            <Font size="18.0" />
        </font>
    </Label>

    <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
        <Label text="Pickup is available at:" textFill="#7f8c8d">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
        <Label text="Icey's TCG Shop" textFill="#e74c3c">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
    </VBox>

    <Button text="Back to Shop" onAction="#onBackToShopClick" prefHeight="45.0" prefWidth="250.0"
            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 16px;">
        <VBox.margin>
            <Insets top="40.0" />
        </VBox.margin>
    </Button>

</VBox>