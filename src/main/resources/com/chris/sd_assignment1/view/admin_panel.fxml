<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1080.0" style="-fx-background-color: #f0f4f8;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chris.sd_assignment1.controller.AdminPanelController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #2c3e50;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <Label text="Icey's TCG Shop - Admin Panel" textFill="#3498db">
                <font>
                    <Font name="System Bold" size="24.0" />
                </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Back to Shop" onAction="#onBackToShopClick"
                    style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-cursor: hand;" />
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
            <Tab text="Manage Items">
                <VBox spacing="10.0">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <HBox spacing="10.0">
                        <Button text="Add New Item" onAction="#onAddItemClick"
                                style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-cursor: hand;" />
                        <Button text="Edit Selected" onAction="#onEditItemClick"
                                style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-cursor: hand;" />
                        <Button text="Delete Selected" onAction="#onDeleteItemClick"
                                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;" />
                    </HBox>
                    <TableView fx:id="itemsTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="itemIdCol" text="ID" prefWidth="50.0" />
                            <TableColumn fx:id="itemNameCol" text="Name" prefWidth="250.0" />
                            <TableColumn fx:id="itemCategoryCol" text="Category" prefWidth="150.0" />
                            <TableColumn fx:id="itemPriceCol" text="Price" prefWidth="100.0" />
                            <TableColumn fx:id="itemStockCol" text="Stock" prefWidth="100.0" />
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <Tab text="Manage Categories">
                <VBox spacing="10.0">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <HBox spacing="10.0">
                        <Button text="Add New Category" onAction="#onAddCategoryClick"
                                style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-cursor: hand;" />
                        <Button text="Edit Selected" onAction="#onEditCategoryClick"
                                style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-cursor: hand;" />
                        <Button text="Delete Selected" onAction="#onDeleteCategoryClick"
                                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;" />
                    </HBox>
                    <TableView fx:id="categoriesTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="categoryIdCol" text="ID" prefWidth="50.0" />
                            <TableColumn fx:id="categoryNameCol" text="Name" prefWidth="250.0" />
                            <TableColumn fx:id="categoryDescCol" text="Description" prefWidth="400.0" />
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
        </TabPane>
    </center>

</BorderPane>